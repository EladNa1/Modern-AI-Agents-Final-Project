# CheckMate environment — copy to .env.local and fill in real values.
# Do NOT commit real keys. LLMod.ai is an OpenAI-compatible gateway.
LLMOD_BASE_URL=https://api.llmod.ai/v1
LLMOD_KEY=sk-your-llmod-key-here
LLMOD_MODEL=MB5R2CF-azure/gpt-5.4-mini
LLMOD_EMBED_MODEL=MB5R2CF-azure/text-embedding-3-small

# Pinecone vector RAG (optional). Leave unset to use the bundled-JSON retriever.
# Index is auto-created by scripts/index_kb.ts (dim 1536, cosine, serverless).
PINECONE_API_KEY=pcsk_your-pinecone-key-here
PINECONE_INDEX=checkmate-kb
